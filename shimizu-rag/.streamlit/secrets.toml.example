# Streamlit Cloud 用シークレット設定例
# https://share.streamlit.io/ でアプリのダッシュボード → Settings → Secrets に
# 以下の内容を貼り付けてください（このファイル自体はリポジトリに上げてOKな例示です）。

# 必須
ANTHROPIC_API_KEY = "sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# 任意：パスワード保護を有効化（推奨）
APP_PASSWORD = "your-strong-password-here"

# 任意：クラウド省メモリ向けに埋め込みモデルを軽量版に差し替え
# Streamlit Cloud 無料枠（~1GB RAM）でBGE-M3が苦しい場合に使う
# EMBEDDING_MODEL_NAME = "sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2"
# EMBEDDING_DIM = 384
